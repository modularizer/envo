# =============================================================================
# ENVO Configuration Defaults
# =============================================================================
# This file documents the default values for envo's own configuration.
# These can be overridden via environment variables with the ENVO_ prefix.

# =============================================================================
# Parsing Settings
# =============================================================================

# Special value that indicates "use the default from spec"
ENVO_USE_SPEC_DEFAULT="<default>"

# Default group name for variables without an explicit group
ENVO_DEFAULT_GROUP="unknown"

# Default documentation string when none is provided
ENVO_DEFAULT_DOCS="No help available"

# Values that coerce to True (case-insensitive)
ENVO_BOOL_TRUE_VALUES={"true", "1", "yes", "on", "y", "enable", "enabled"}

# Values that coerce to False (case-insensitive)
ENVO_BOOL_FALSE_VALUES={"false", "0", "no", "off", "n", "disable", "disabled"}

# Values that coerce to None (case-insensitive)
ENVO_NULL_VALUES={"null", "none"}

# Maximum iterations for resolving $VAR_NAME references (prevents infinite loops)
ENVO_VAR_REFERENCE_MAX_ITERATIONS=20

# Project root substitution character
ENVO_PROJECT_ROOT_CHAR="%"

# Variable reference character (e.g., $VAR_NAME becomes the value of VAR_NAME)
ENVO_REF_CHAR="$"

# =============================================================================
# Key Status Constants (for display/styling)
# =============================================================================

ENVO_KEY_STATUS_DEFAULT="default"
ENVO_KEY_STATUS_VALID="valid"
ENVO_KEY_STATUS_INVALID="invalid"
ENVO_KEY_STATUS_EXTRA="extra"

# =============================================================================
# Color Scheme - Key Colors
# =============================================================================
# Hex values chosen to work on both black and white terminal backgrounds

ENVO_KEY_COLOR_DEFAULT="#5f9ea0"
ENVO_KEY_COLOR_VALID="#0087d7"
ENVO_KEY_COLOR_INVALID="#d70000"
ENVO_KEY_COLOR_EXTRA="#875faf"
ENVO_KEY_COLOR_DEFAULT_VALUE="#0087d7"

# =============================================================================
# Color Scheme - Value Colors
# =============================================================================

ENVO_VALUE_COLOR_DIM="#808080"
ENVO_VALUE_COLOR_GREEN="#00af00"
ENVO_VALUE_COLOR_RED="#d70000"
ENVO_VALUE_COLOR_YELLOW="#ff8700"
ENVO_VALUE_COLOR_BLUE="#005fd7"
ENVO_VALUE_COLOR_WHITE=""

# =============================================================================
# Color Scheme - UI Colors
# =============================================================================

ENVO_HIGHLIGHT_BG_COLOR="#f5c842"
ENVO_UI_TEXT_DIM="#666666"

# =============================================================================
# Color Scheme - Highlighted State (on yellow background)
# =============================================================================

ENVO_KEY_COLOR_DEFAULT_HIGHLIGHT="#1a3a4f"
ENVO_KEY_COLOR_VALID_HIGHLIGHT="#003070"
ENVO_KEY_COLOR_INVALID_HIGHLIGHT="#700000"
ENVO_KEY_COLOR_EXTRA_HIGHLIGHT="#4f1f6f"
ENVO_KEY_COLOR_DEFAULT_VALUE_HIGHLIGHT="#003070"

ENVO_VALUE_COLOR_DIM_HIGHLIGHT="#2a2a2a"
ENVO_VALUE_COLOR_GREEN_HIGHLIGHT="#004d00"
ENVO_VALUE_COLOR_RED_HIGHLIGHT="#700000"
ENVO_VALUE_COLOR_YELLOW_HIGHLIGHT="#704f00"
ENVO_VALUE_COLOR_BLUE_HIGHLIGHT="#003070"
ENVO_VALUE_COLOR_WHITE_HIGHLIGHT="#000000"
ENVO_HIGHLIGHT_TEXT_COLOR_DIM="#2a2a2a"

# =============================================================================
# UI Text and Formatting
# =============================================================================

ENVO_UI_SEPARATOR_CHAR="─"
ENVO_R=25
ENVO_UI_SEPARATOR_WIDTH=80
ENVO_UI_HELP_BROWSE="↑↓ Navigate  Enter Edit  ^S Save  ^Q Quit"
ENVO_UI_HELP_EDIT="Press Enter to save, Ctrl+C to cancel"
ENVO_UI_NOT_SET="(not set)"
ENVO_UI_VALID_PREFIX="✓ Valid"
ENVO_UI_INVALID_PREFIX="✗ Invalid"
ENVO_UI_CHANGE_ARROW=" → "
ENVO_CYCLE_ENDLESSLY=true


ENVO_MODE=dev
ENVO_IS_PROD=$ENVO_MODE=="prod"
ENVO_COUNT=($ENVO_MODE=="prod")?5:10